{
  "name": "pokeidle-multi",
  "productName": "PokeIdle Multi",
  "version": "0.1.1",
  "private": true,
  "description": "Quatro sessões independentes do PokeIdle",
  "author": "Local",
  "dependencies": { "electron-updater": "6.8.9" },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "main": "src/main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "dist": "electron-builder --config electron-builder.config.cjs --win nsis --x64 --publish never",
    "pack": "electron-builder --config electron-builder.config.cjs --win --dir --x64 --publish never"
  },
  "build": {
    "appId": "local.pokeidle.multi",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis", "signAndEditExecutable": true, "signExecutable": false },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "deleteAppDataOnUninstall": false }
  }
}
